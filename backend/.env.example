# DHMS Backend Environment Variables
# Copy this file to `.env` and fill in your real values.

# Port the Express server listens on (Render sets this automatically)
PORT=5000

# Your Supabase project URL
# https://supabase.com/dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Service Role Key (has elevated privileges - NEVER expose to frontend)
# Project Settings -> API -> service_role secret
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Supabase Anon / Public key (used for user authentication)
# Project Settings -> API -> anon public key
SUPABASE_ANON_KEY=your-anon-key
